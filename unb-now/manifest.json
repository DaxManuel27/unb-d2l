{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "version": "0.4.4",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://lms.unb.ca/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lms.unb.ca/*"
      ],
      "js": [
        "src/content/learn-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src https://lms.unb.ca; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
  }
}
